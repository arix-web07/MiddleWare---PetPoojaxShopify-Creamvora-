# ==============================================================================
# SHOPIFY <-> PETPOOJA DIRECT ORDER SYNC (VERCEL HOSTED)
# ONLY Shopify, Petpooja, GitHub, and Vercel. Zero external databases or tools.
# ==============================================================================

# 1. Application URL (Your live Vercel domain)
APP_URL="https://petpooja-middleware1.vercel.app"

# 2. Shopify Webhook Configuration
# Obtain from Shopify Admin -> Settings -> Notifications -> Webhooks (bottom of page)
SHOPIFY_WEBHOOK_SECRET="your_shopify_webhook_signing_secret"

# 3. Petpooja POS API Configuration (Production Credentials)
PETPOOJA_ENV="production"
PETPOOJA_APP_KEY="YOUR_PETPOOJA_APP_KEY"
PETPOOJA_APP_SECRET="YOUR_PETPOOJA_APP_SECRET"
PETPOOJA_ACCESS_TOKEN="YOUR_PETPOOJA_ACCESS_TOKEN"
PETPOOJA_REST_ID="YOUR_PETPOOJA_REST_ID"
PETPOOJA_RESTAURANT_ID="451593"
PETPOOJA_RESTAURANT_NAME="Cremevora"

# 4. Petpooja Production Endpoints
PETPOOJA_ORDER_API_URL="https://pponlineordercb.petpooja.com/save_order"
PETPOOJA_RIDER_STATUS_URL="https://pponlineordercb.petpooja.com/rider_status_update"
PETPOOJA_UPDATE_ORDER_STATUS_URL="https://pponlineordercb.petpooja.com/update_order_status"

# 5. Optional Settings
DEFAULT_ORDER_TYPE="Delivery"

